  "chorus": null,
  "verses": [
    {
      "lines": [
        "Et barn er født i Bethlehem,",
        "Bethlehem,",
        "thi glæder sig Jerusalem."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "En fattig jomfru sad i løn,",
        "sad i løn,",
        "og fødte himlens kongesøn."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Han lagdes i et krybberum,",
        "krybberum,",
        "Guds engle sang med fryd derom."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Og østens vise ofred der,",
        "ofred der,",
        "Guld, røgelse og myrra skær."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Forvunden er nu al vor nød,",
        "al vor nød,",
        "os er i dag en frelser fød."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Guds kære børn vi blev påny,",
        "blev påny,",
        "skal holde jul i himmelby."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "På stjernetæpper lyse blå,",
        "lyseblå,",
        "skal glade vi til kirke gå."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Guds engle der os lære brat,",
        "lære brat,",
        "at synge, som de sang i nat."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Da vorde engle vi som de,",
        "vi som de,",
        "Guds milde ansigt skal vi se."
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    },
    {
      "lines": [
        "Ham være pris til evig tid,",
        "evig tid,",
        "for frelser bold og broder blid!"
      ],
      "refrain": [
        "Halleluja, halleluja!"
      ]
    }
  ]
}
