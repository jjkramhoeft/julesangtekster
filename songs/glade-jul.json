  "id": "glade-jul",
  "idNumber": 12,
  "title": "Glade jul, dejlige jul",
  "firstLine": "Glade jul, dejlige jul",
  "type": "julesalme",
  "author": "B.S. Ingemann",
  "translator": null,
  "year": 1850,
  "composer": "Franz Xaver Gruber, 1818",
  "dds": 120,
  "hsb": 249,
  "extraInfo": "Ingemanns tekst er skrevet til Franz Grubers melodi fra 1818, den samme melodi som »Stille Nacht«. Salmen synges om juletræet og afslutter ofte gudstjenesten juleaften.",
  "source": {
    "name": "Wikisource",
    "url": "https://da.wikisource.org/w/index.php?oldid=36046",
    "revision": 36046,
    "license": "Public domain (ophavsretsloven § 63)"
  },
  "chorus": null,
  "verses": [
    [
      "Glade jul, dejlige jul,",
      "engle daler ned i skjul",
      "Hid de flyver med paradisgrønt",
      "hvor de ser, hvad for Gud er kønt",
      "lønlig iblandt os de går",
      "lønlig iblandt os de går."
    ],
    [
      "Julefred, evige fred",
      "hellig sang med himmelsk lyd",
      "Det er englene, hyrderne så",
      "dengang Herren i krybben lå",
      "evig er englenes sang",
      "evig er englenes sang."
    ],
    [
      "Fred på jord, fryd på jord",
      "Jesusbarnet blandt os bor!",
      "Engle sjunger om barnet så smukt,",
      "han har Himmerigs dør oplukt,",
      "salig er englenes sang",
      "salig er englenes sang."
    ],
    [
      "Salig fred, himmelsk fred",
      "toner julenat herned!",
      "Engle bringer til store og små",
      "bud om ham, som i krybben lå;",
      "fryd dig, hver sjæl han har frelst!",
      "fryd dig, hver sjæl han har frelst!"
    ]
  ]
}
